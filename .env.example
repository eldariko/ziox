# Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Set GEMINI_SEARCH_GROUNDING=true only if your Google Cloud project has billing enabled for Search Grounding
GEMINI_SEARCH_GROUNDING=false

# Twitter / X Provider Configuration
# Choose: "mock" (offline test), "twikit" (direct session cookie automation), or "zernio" (API bridge)
TWITTER_PROVIDER=mock

# Twikit Direct Session Authentication (Recommended for direct replies to 3rd-party posts)
# Extract 'auth_token' and 'ct0' from your browser cookies on x.com:
X_AUTH_TOKEN=your_auth_token_cookie_here
X_CT0=your_ct0_cookie_here
X_COOKIES_FILE=cookies.json

# Zernio API Configuration (Required if TWITTER_PROVIDER=zernio)
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_TWITTER_ACCOUNT_ID=your_twitter_account_id_here

# Bot Operation Mode
# Set DRY_RUN=true to simulate decisions and replies without publishing to X
DRY_RUN=true

# Virality Threshold (Score above which a tweet is flagged for factual review)
VIRALITY_THRESHOLD=5.0

# Max replies per calendar month (Safety ceiling)
MONTHLY_MAX_REPLIES=30

# Max turns per conversation thread before auto-disengaging (1 root reply + 1 counter reply)
MAX_THREAD_TURNS=2

# SQLite Database Path
DATABASE_PATH=ziox.db

# Turso Cloud Database (leave empty to use local SQLite at DATABASE_PATH)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Telegram Community Dispatcher
TELEGRAM_BOT_TOKEN=
# Admin chat ID (receives scanner health alerts only; regular subscribers never do)
TELEGRAM_CHAT_ID=
TELEGRAM_REVIEW_ENABLED=false

# Scanner Safety (use a DEDICATED scout X account, never your personal account)
COMBINE_SEARCH_QUERIES=true
MAX_KEYWORDS_PER_QUERY=6
MIN_SEARCH_DELAY_SECONDS=6
MAX_SEARCH_DELAY_SECONDS=15
SEARCH_MIN_FAVES=20
SCANNER_COOLDOWN_MINUTES=720
START_JITTER_MAX_MINUTES=15

# Community Scale
VARIATIONS_PER_TWEET=4
MAX_VARIATIONS_PER_GEMINI_CALL=10
TARGET_COHORT_SIZE_PER_TWEET=25
TELEGRAM_TWEETS_PER_CYCLE=10
NO_LINK_VARIATION_RATIO=0.4
MAX_USER_DAILY_LIMIT=5
MAX_UNCONFIRMED_DISPATCHES=5
